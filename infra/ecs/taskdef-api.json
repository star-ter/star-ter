{
  "containerDefinitions": [
    {
      "name": "api",
      "image": "REPLACE_ME",
      "cpu": 0,
      "portMappings": [
        {
          "containerPort": 4000,
          "hostPort": 4000,
          "protocol": "tcp",
          "name": "api-4000-tcp",
          "appProtocol": "http"
        }
      ],
      "secrets": [
        {
          "name": "PORT",
          "valueFrom": "${AWS_ARN_PORT}"
        },
        {
          "name": "DATABASE_URL",
          "valueFrom": "${AWS_ARN_DATABASE_URL}"
        },
        {
          "name": "ALLOW_ORIGIN",
          "valueFrom": "${AWS_ARN_ALLOW_ORIGIN}"
        },
        {
          "name": "OPENAI_API_KEY",
          "valueFrom": "${AWS_ARN_OPENAI_API_KEY}"
        },
        {
          "name": "AWS_ACCESS_KEY_ID",
          "valueFrom": "${AWS_ARN_AWS_ACCESS_KEY_ID}"
        },
        {
          "name": "AWS_SECRET_ACCESS_KEY",
          "valueFrom": "${AWS_ARN_AWS_SECRET_ACCESS_KEY}"
        },
        {
          "name": "AWS_REGION",
          "valueFrom": "${AWS_ARN_AWS_REGION}"
        },
        {
          "name": "AWS_S3_BUCKET",
          "valueFrom": "${AWS_ARN_AWS_S3_BUCKET}"
        },
        {
          "name": "GOOGLE_CLIENT_ID",
          "valueFrom": "${AWS_ARN_GOOGLE_CLIENT_ID}"
        },
        {
          "name": "GOOGLE_CLIENT_SECRET",
          "valueFrom": "${AWS_ARN_GOOGLE_CLIENT_SECRET}"
        },
        {
          "name": "NAVER_CLIENT_ID",
          "valueFrom": "${AWS_ARN_NAVER_CLIENT_ID}"
        },
        {
          "name": "NAVER_CLIENT_SECRET",
          "valueFrom": "${AWS_ARN_NAVER_CLIENT_SECRET}"
        },
        {
          "name": "ANTHROPIC_API_KEY",
          "valueFrom": "${AWS_ARN_ANTHROPIC_API_KEY}"
        }
      ],
      "essential": true,
      "environment": [],
      "environmentFiles": [],
      "mountPoints": [],
      "volumesFrom": [],
      "ulimits": [],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/starter-api-task",
          "awslogs-create-group": "true",
          "awslogs-region": "ap-northeast-2",
          "awslogs-stream-prefix": "ecs"
        },
        "secretOptions": []
      },
      "systemControls": []
    }
  ],
  "family": "starter-api-task",
  "executionRoleArn": "REPLACE_EXEC_ROLE_ARN",
  "networkMode": "awsvpc",
  "volumes": [],
  "placementConstraints": [],
  "runtimePlatform": {
    "cpuArchitecture": "X86_64",
    "operatingSystemFamily": "LINUX"
  },
  "requiresCompatibilities": [
    "EC2"
  ],
  "cpu": "1024",
  "memory": "512",
  "enableFaultInjection": false
}
