model imageInfo {
  id           String     @id @default(uuid()) @db.Uuid
  s3_key       String     @unique(map: "unique_image_s3_key") @db.VarChar(512)
  user_id      String     @db.Uuid
  created_at   DateTime   @default(now()) @db.Timestamptz(6)
  is_deleted   Boolean    @default(false)
  user_profile user_info? @relation("UserProfileImage")

  @@map("image_info")
}
