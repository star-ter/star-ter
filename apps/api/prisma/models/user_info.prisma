model user_info {
  id                       String                 @id @default(uuid()) @db.Uuid
  email                    String                 @unique
  password                 String
  nickname                 String
  createdAt                DateTime               @default(now())
  updatedAt                DateTime               @updatedAt
  on_boarding_completed    Boolean                @default(false)
  preferred_business_hours String?
  preferred_industry       String?
  preferred_region         String?
  startup_capital          String?
  target_age_group         String?
  profile_image_id         String?                @unique @db.Uuid
  bookmark                 bookmark[]
  conversations            conversation[]
  real_estate_bookmark     real_estate_bookmark[]
  real_estate_info         real_estate_info[]
  profile_image            imageInfo?             @relation("UserProfileImage", fields: [profile_image_id], references: [id], onUpdate: NoAction)
}

model bookmark {
  id             String    @id
  user_id        String    @db.Uuid
  commercialCode String
  commercialName String
  createdAt      DateTime  @default(now())
  user           user_info @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([user_id, commercialCode])
}
